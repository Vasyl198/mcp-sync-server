        0.08,
        0.1
      ],
      "layers": [
        2,
        3,
        4,
        5
      ],
      "noise": [
        0.08,
        0.14,
        0.2
      ]
    },
    "metric_schema": {
      "score": {
        "pattern": "score=([0-9.]+)",
        "source": "stdout",
        "type": "float"
      }
    },
    "exec_command": "node -e \"const lr={lr};const layers={layers};const nz={noise};const target=0.045;const base=1-Math.abs(lr-target)*8-Math.abs(layers-3.5)*0.08;const noise=(Math.random()*nz)-(nz/2);console.log('score='+(base+noise).toFixed(4));\"",
