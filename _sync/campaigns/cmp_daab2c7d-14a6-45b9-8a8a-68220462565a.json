{
  "campaign_id": "cmp_daab2c7d-14a6-45b9-8a8a-68220462565a",
  "goal": "Overlap Pressure B2 - noisy medium partially overlapping LR",
  "objective": "maximize score",
  "constraints": {
    "experiment_name": "campaign_overlap_B2",
    "search_space": {
      "lr": [
        0.01,
