# Порт MCP сервера
PORT=3000

# Токен для Authorization: Bearer <token>
MCP_SYNC_TOKEN=change-me-long-random

# Режим авторизации:
# - true/1/on/enabled  -> всегда требовать Bearer token
# - false/0/off/disabled -> выключить авторизацию (dev-режим)
# - пусто -> авто: auth включен, если MCP_SYNC_TOKEN непустой
AUTH_ENABLED=

# Разрешённые Origin (CSV). Если пусто — Origin не проверяем.
# MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCP_ALLOWED_ORIGINS=

# Разрешённые корни ФС (CSV абсолютных путей). Если пусто — только папка mcp-sync-server.
# Пример (mac/linux): MCP_ALLOWED_ROOTS=/Users/me/projects/myrepo
# Пример (win): MCP_ALLOWED_ROOTS=C:\\Users\\me\\projects\\myrepo
MCP_ALLOWED_ROOTS=

# Sync engine settings
SYNC_DIR=./_sync
SYNC_ENABLED=false
SYNC_POLL_MS=3000
SYNC_BATCH_SIZE=50
EXPOSE_LEGACY_TOOLS=0

# OpenAI bridge (for upcoming bidirectional sync worker)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000
SYNC_MOCK_MODE=false

# LLM helper action pipeline (safe by default)
LLM_HELPER_DRY_RUN=true
LLM_HELPER_ENABLE_TASKS=false
LLM_HELPER_ENABLE_GOVERNANCE=false
LLM_HELPER_ENABLE_TOOLS=false
LLM_HELPER_MAX_ACTIONS=3
LLM_HELPER_ALLOWED_TOOL_COMMANDS=sync_status,intelligence_meta_snapshot,intelligence_health_snapshot,arena_telemetry_snapshot,transfer_diagnostics,mutation_effectiveness_snapshot,lineage_snapshot,research_agenda_tick,patch_proposal_tick,patch_test_tick,patch_governance_tick
