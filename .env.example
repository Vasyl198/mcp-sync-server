# Порт MCP сервера
PORT=3000

# Токен для Authorization: Bearer <token>
MCP_SYNC_TOKEN=change-me-long-random

# Режим авторизации:
# - true/1/on/enabled  -> всегда требовать Bearer token
# - false/0/off/disabled -> выключить авторизацию (dev-режим)
# - пусто -> авто: auth включен, если MCP_SYNC_TOKEN непустой
AUTH_ENABLED=

# Разрешённые Origin (CSV). Если пусто — Origin не проверяем.
# MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCP_ALLOWED_ORIGINS=

# Разрешённые корни ФС (CSV абсолютных путей). Если пусто — только папка mcp-sync-server.
# Пример (mac/linux): MCP_ALLOWED_ROOTS=/Users/me/projects/myrepo
# Пример (win): MCP_ALLOWED_ROOTS=C:\\Users\\me\\projects\\myrepo
MCP_ALLOWED_ROOTS=
